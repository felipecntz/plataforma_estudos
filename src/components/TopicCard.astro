---
interface Props {
  title: string;
  description: string;
  href: string;
  kicker?: string;
}

const { title, description, href, kicker = "Topico" } = Astro.props;
---

<a class="topic-card" href={href}>
  <span class="eyebrow">{kicker}</span>
  <h3 style="font-size:1.35rem;margin:0.45rem 0 0.55rem;">{title}</h3>
  <p class="lede" style="font-size:0.96rem;margin:0;">{description}</p>
</a>
